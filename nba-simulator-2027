<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>2026-27赛季NBA赛事模拟与战术分析系统</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#165DFF',
                        secondary: '#4080FF',
                        dark: '#0E2B5C'
                    }
                }
            }
        }
    </script>
    <style>
        .tab-active { background: #165DFF; color: white; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        .card { background: white; border-radius: 12px; box-shadow: 0 2px 12px rgba(22,93,255,0.1); padding: 20px; margin-bottom: 16px; }
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        th, td { padding: 6px 8px; border: 1px solid #e5e7eb; text-align: center; }
        th { background: #f0f7ff; color: #0E2B5C; font-weight: 600; }
        .player-item { padding: 6px 10px; border: 1px solid #e5e7eb; border-radius: 6px; margin: 2px; cursor: pointer; transition: all 0.2s; font-size: 13px; }
        .player-item:hover { background: #f0f7ff; border-color: #165DFF; }
        .player-item.selected { background: #165DFF; color: white; }
        .injured { opacity: 0.5; text-decoration: line-through; }
        #gameCanvas { border: 2px solid #165DFF; border-radius: 8px; background: #f0f7ff; display: block; margin: 0 auto; }
        .standings-east, .standings-west { width: 48%; }
        .playoff-bracket { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
        .playoff-round { flex: 1; }
        .playoff-match { border: 1px solid #e5e7eb; border-radius: 6px; padding: 8px; margin: 8px 0; font-size: 12px; background: #f9fafb; }
        .playoff-match.winner { border-color: #165DFF; background: #f0f7ff; font-weight: bold; }
    </style>
</head>
<body class="bg-gray-50 min-h-screen">
    <!-- 顶部导航 -->
    <header class="bg-gradient-to-r from-primary to-secondary text-white py-4 px-6 shadow-lg">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <h1 class="text-2xl font-bold">🏀 2026-27赛季NBA赛事模拟与战术分析系统</h1>
            <span class="text-sm opacity-80">全功能增强版 · 纯前端离线运行</span>
        </div>
    </header>

    <div class="max-w-7xl mx-auto p-6">
        <!-- 标签页导航 -->
        <div class="flex gap-2 mb-6 flex-wrap">
            <button class="tab-btn tab-active px-4 py-2 rounded-lg font-medium transition-all text-sm" onclick="switchTab(0)">数据管理</button>
            <button class="tab-btn bg-white text-gray-700 px-4 py-2 rounded-lg font-medium transition-all hover:bg-blue-50 text-sm" onclick="switchTab(1)">竞争力分析</button>
            <button class="tab-btn bg-white text-gray-700 px-4 py-2 rounded-lg font-medium transition-all hover:bg-blue-50 text-sm" onclick="switchTab(2)">比赛模拟</button>
            <button class="tab-btn bg-white text-gray-700 px-4 py-2 rounded-lg font-medium transition-all hover:bg-blue-50 text-sm" onclick="switchTab(3)">战术建议</button>
            <button class="tab-btn bg-white text-gray-700 px-4 py-2 rounded-lg font-medium transition-all hover:bg-blue-50 text-sm" onclick="switchTab(4)">阵容交易</button>
            <button class="tab-btn bg-white text-gray-700 px-4 py-2 rounded-lg font-medium transition-all hover:bg-blue-50 text-sm" onclick="switchTab(5)">赛季模拟</button>
            <button class="tab-btn bg-white text-gray-700 px-4 py-2 rounded-lg font-medium transition-all hover:bg-blue-50 text-sm" onclick="switchTab(6)">规则设置</button>
            <button class="tab-btn bg-white text-gray-700 px-4 py-2 rounded-lg font-medium transition-all hover:bg-blue-50 text-sm" onclick="switchTab(7)">历史记录</button>
        </div>

        <!-- 标签页1：数据管理 -->
        <div class="tab-content active" id="tab-0">
            <div class="card">
                <h3 class="text-lg font-bold text-dark mb-4">📊 Excel球队数据导入（适配2026-27赛季模板）</h3>
                <p class="text-gray-600 text-sm mb-4">支持.xlsx格式，自动识别球队、球员、场均数据等字段，新秀自动生成基准评分</p>
                <div class="flex gap-4 items-center mb-4 flex-wrap">
                    <input type="file" id="excelFile" accept=".xlsx,.xls" class="border rounded-lg p-2 flex-1 min-w-[200px]">
                    <button onclick="importExcel()" class="bg-primary text-white px-6 py-2 rounded-lg hover:bg-secondary transition">导入数据</button>
                    <button onclick="clearAllData()" class="bg-red-500 text-white px-6 py-2 rounded-lg hover:bg-red-600 transition">清空数据</button>
                </div>
                <div id="importTip" class="text-sm text-green-600 mb-4 hidden">✅ 导入成功！共加载 <span id="teamCount">0</span> 支球队，<span id="playerCount">0</span> 名球员</div>
            </div>

            <div class="card">
                <h3 class="text-lg font-bold text-dark mb-4">🏆 已导入球队列表</h3>
                <div id="teamList" class="grid grid-cols-2 md:grid-cols-5 gap-3">
                    <div class="text-gray-400 col-span-full text-center py-8">暂无数据，请先导入Excel文件</div>
                </div>
            </div>

            <div class="card" id="playerDetailCard" style="display:none;">
                <h3 class="text-lg font-bold text-dark mb-4">👥 球队球员详情</h3>
                <div class="flex gap-2 mb-4">
                    <select id="detailTeamSelect" class="border rounded-lg p-2 w-64" onchange="renderPlayerDetail()"></select>
                    <button onclick="toggleInjuryMode()" id="injuryModeBtn" class="bg-orange-500 text-white px-4 py-2 rounded-lg text-sm">设置伤病模式</button>
                </div>
                <div id="playerDetailTable"></div>
            </div>
        </div>

        <!-- 标签页2：竞争力分析 -->
        <div class="tab-content" id="tab-1">
            <div class="card">
                <h3 class="text-lg font-bold text-dark mb-4">📈 球队竞争力排名</h3>
                <div class="flex gap-4 mb-4 flex-wrap">
                    <select id="rankSort" class="border rounded-lg p-2 w-48" onchange="renderRank()">
                        <option value="overall">综合评分</option>
                        <option value="offense">进攻评分</option>
                        <option value="defense">防守评分</option>
                        <option value="depth">阵容深度</option>
                        <option value="clutch">关键球能力</option>
                    </select>
                    <button onclick="renderRank()" class="bg-primary text-white px-4 py-2 rounded-lg">刷新排名</button>
                </div>
                <table id="rankTable">
                    <thead>
                        <tr>
                            <th>排名</th>
                            <th>球队</th>
                            <th>综合</th>
                            <th>进攻</th>
                            <th>防守</th>
                            <th>阵容深度</th>
                            <th>关键球</th>
                            <th>三分</th>
                            <th>内线</th>
                        </tr>
                    </thead>
                    <tbody id="rankBody"></tbody>
                </table>
            </div>

            <div class="card">
                <h3 class="text-lg font-bold text-dark mb-4">🎯 双队能力雷达对比</h3>
                <div class="flex gap-4 mb-4">
                    <select id="radarTeam1" class="border rounded-lg p-2 flex-1"></select>
                    <select id="radarTeam2" class="border rounded-lg p-2 flex-1"></select>
                    <button onclick="renderRadar()" class="bg-primary text-white px-4 py-2 rounded-lg">生成对比</button>
                </div>
                <div style="max-width: 600px; margin: 0 auto;">
                    <canvas id="radarChart"></canvas>
                </div>
            </div>
        </div>

        <!-- 标签页3：比赛模拟 -->
        <div class="tab-content" id="tab-2">
            <div class="card">
                <h3 class="text-lg font-bold text-dark mb-4">⚔️ 比赛设置</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                    <div>
                        <label class="block text-sm font-medium mb-1">主场球队</label>
                        <select id="homeTeam" class="border rounded-lg p-2 w-full"></select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">客场球队</label>
                        <select id="awayTeam" class="border rounded-lg p-2 w-full"></select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">模拟次数</label>
                        <select id="simTimes" class="border rounded-lg p-2 w-full">
                            <option value="100">100次（快速）</option>
                            <option value="1000" selected>1000次（标准）</option>
                            <option value="5000">5000次（精准）</option>
                        </select>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-sm font-medium mb-1">主场战术</label>
                        <select id="homeTactic" class="border rounded-lg p-2 w-full">
                            <option value="auto">自动均衡</option>
                            <option value="insideAttack">内线强攻</option>
                            <option value="threePointShoot">三分投射</option>
                            <option value="pickAndRoll">挡拆突破</option>
                            <option value="fastBreak">快攻反击</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">客场战术</label>
                        <select id="awayTactic" class="border rounded-lg p-2 w-full">
                            <option value="auto">自动均衡</option>
                            <option value="insideAttack">内线强攻</option>
                            <option value="threePointShoot">三分投射</option>
                            <option value="pickAndRoll">挡拆突破</option>
                            <option value="fastBreak">快攻反击</option>
                        </select>
                    </div>
                </div>
                <div class="flex gap-3 flex-wrap">
                    <button onclick="runSingleSim()" class="bg-primary text-white px-6 py-2 rounded-lg hover:bg-secondary transition">单场精细模拟</button>
                    <button onclick="startGameAnimation()" class="bg-dark text-white px-6 py-2 rounded-lg hover:bg-primary transition">比赛动画演示</button>
                    <button onclick="runBatchSim()" class="bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700 transition">批量蒙特卡洛模拟</button>
                    <button onclick="exportSimResult()" class="bg-gray-600 text-white px-6 py-2 rounded-lg hover:bg-gray-700 transition">导出结果</button>
                </div>
            </div>

            <!-- 比赛动画 -->
            <div class="card" id="animationCard" style="display:none;">
                <h3 class="text-lg font-bold text-dark mb-4">🎬 比赛动画演示</h3>
                <div class="text-center mb-4">
                    <div class="flex justify-center items-center gap-8 text-xl font-bold">
                        <span id="animHomeName" class="text-primary">主队</span>
                        <span><span id="animHomeScore" class="text-3xl">0</span> : <span id="animAwayScore" class="text-3xl">0</span></span>
                        <span id="animAwayName" class="text-secondary">客队</span>
                    </div>
                    <p id="animQuarter" class="text-gray-600 mt-1">第一节 00:00</p>
                    <p id="animEvent" class="text-sm text-dark mt-1 font-medium">比赛即将开始...</p>
                </div>
                <canvas id="gameCanvas" width="800" height="450"></canvas>
                <div class="flex justify-center gap-4 mt-4">
                    <button onclick="pauseAnimation()" id="animPauseBtn" class="bg-primary text-white px-6 py-2 rounded-lg">暂停</button>
                    <button onclick="resetAnimation()" class="bg-gray-500 text-white px-6 py-2 rounded-lg">重置</button>
                </div>
            </div>

            <!-- 单场模拟结果 -->
            <div class="card" id="singleResultCard" style="display:none;">
                <h3 class="text-lg font-bold text-dark mb-4">📋 单场模拟详情</h3>
                <div class="text-center mb-4">
                    <div class="flex justify-center items-center gap-8 text-xl font-bold">
                        <span id="singleHomeName" class="text-primary">主队</span>
                        <span><span id="singleHomeScore" class="text-3xl">0</span> : <span id="singleAwayScore" class="text-3xl">0</span></span>
                        <span id="singleAwayName" class="text-secondary">客队</span>
                    </div>
                    <p id="singleResultText" class="text-gray-600 mt-2"></p>
                </div>
                <table class="mb-4">
                    <thead>
                        <tr>
                            <th>球队</th>
                            <th>第一节</th>
                            <th>第二节</th>
                            <th>第三节</th>
                            <th>第四节</th>
                            <th>总分</th>
                        </tr>
                    </thead>
                    <tbody id="quarterBody"></tbody>
                </table>
            </div>

            <!-- 批量模拟结果 -->
            <div class="card" id="batchResultCard" style="display:none;">
                <h3 class="text-lg font-bold text-dark mb-4">📊 批量模拟统计（蒙特卡洛）</h3>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
                    <div class="bg-blue-50 rounded-lg p-4 text-center">
                        <div class="text-2xl font-bold text-primary" id="homeWinRate">0%</div>
                        <div class="text-sm text-gray-600">主队胜率</div>
                    </div>
                    <div class="bg-gray-50 rounded-lg p-4 text-center">
                        <div class="text-2xl font-bold text-gray-700" id="awayWinRate">0%</div>
                        <div class="text-sm text-gray-600">客队胜率</div>
                    </div>
                    <div class="bg-green-50 rounded-lg p-4 text-center">
                        <div class="text-2xl font-bold text-green-600" id="avgTotalScore">0</div>
                        <div class="text-sm text-gray-600">场均总得分</div>
                    </div>
                    <div class="bg-orange-50 rounded-lg p-4 text-center">
                        <div class="text-2xl font-bold text-orange-600" id="avgDiff">0</div>
                        <div class="text-sm text-gray-600">场均分差</div>
                    </div>
                </div>
                <div style="max-width: 700px; margin: 0 auto;">
                    <canvas id="scoreDistChart"></canvas>
                </div>
            </div>
        </div>

        <!-- 标签页4：战术建议 -->
        <div class="tab-content" id="tab-3">
            <div class="card">
                <h3 class="text-lg font-bold text-dark mb-4">🧠 智能战术寻优</h3>
                <p class="text-gray-600 text-sm mb-4">系统自动遍历所有16种攻防战术组合，计算胜率最高的战术搭配，给出针对性建议</p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-sm font-medium mb-1">我方球队</label>
                        <select id="myTeam" class="border rounded-lg p-2 w-full"></select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">对手球队</label>
                        <select id="opponentTeam" class="border rounded-lg p-2 w-full"></select>
                    </div>
                </div>
                <button onclick="getTacticAdvice()" class="bg-primary text-white px-6 py-2 rounded-lg hover:bg-secondary transition">生成战术建议</button>
            </div>

            <div class="card" id="tacticResultCard" style="display:none;">
                <h3 class="text-lg font-bold text-dark mb-4">✅ 最优战术方案</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div class="border-l-4 border-primary pl-4">
                        <h4 class="font-bold text-primary mb-2">推荐进攻战术</h4>
                        <p id="bestOffTactic" class="text-lg font-medium"></p>
                        <p id="offTacticReason" class="text-sm text-gray-600 mt-1"></p>
                    </div>
                    <div class="border-l-4 border-green-500 pl-4">
                        <h4 class="font-bold text-green-600 mb-2">推荐防守战术</h4>
                        <p id="bestDefTactic" class="text-lg font-medium"></p>
                        <p id="defTacticReason" class="text-sm text-gray-600 mt-1"></p>
                    </div>
                </div>
                <div class="bg-blue-50 rounded-lg p-4 mb-4">
                    <h4 class="font-bold text-dark mb-2">📌 针对性战术建议</h4>
                    <ul id="tacticTips" class="text-sm text-gray-700 space-y-1"></ul>
                </div>
                <div>
                    <h4 class="font-bold text-dark mb-2">📊 全战术组合胜率表</h4>
                    <table id="tacticTable">
                        <thead>
                            <tr>
                                <th>进攻战术\防守战术</th>
                                <th>收缩内线</th>
                                <th>外线盯人</th>
                                <th>区域联防</th>
                                <th>全场紧逼</th>
                            </tr>
                        </thead>
                        <tbody id="tacticTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 标签页5：阵容交易 -->
        <div class="tab-content" id="tab-4">
            <div class="card">
                <h3 class="text-lg font-bold text-dark mb-4">🔄 阵容交易试算</h3>
                <p class="text-gray-600 text-sm mb-4">选择两队球员进行交易，实时查看战力变化与交易评级</p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium mb-2">球队A</label>
                        <select id="tradeTeamA" class="border rounded-lg p-2 w-full mb-3" onchange="renderTradePlayers('A')"></select>
                        <div id="tradePlayersA" class="border rounded-lg p-3 min-h-[200px] bg-gray-50 flex flex-wrap content-start"></div>
                        <div class="mt-3 text-sm">
                            <span class="font-medium">交易前战力：</span><span id="teamAPreScore" class="text-primary font-bold">-</span>
                            <span class="ml-4 font-medium">交易后战力：</span><span id="teamAPostScore" class="text-primary font-bold">-</span>
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-2">球队B</label>
                        <select id="tradeTeamB" class="border rounded-lg p-2 w-full mb-3" onchange="renderTradePlayers('B')"></select>
                        <div id="tradePlayersB" class="border rounded-lg p-3 min-h-[200px] bg-gray-50 flex flex-wrap content-start"></div>
                        <div class="mt-3 text-sm">
                            <span class="font-medium">交易前战力：</span><span id="teamBPreScore" class="text-primary font-bold">-</span>
                            <span class="ml-4 font-medium">交易后战力：</span><span id="teamBPostScore" class="text-primary font-bold">-</span>
                        </div>
                    </div>
                </div>
                <div class="flex justify-center gap-4 mt-6">
                    <button onclick="executeTrade()" class="bg-primary text-white px-8 py-2 rounded-lg hover:bg-secondary transition">执行交易</button>
                    <button onclick="resetTrade()" class="bg-gray-500 text-white px-8 py-2 rounded-lg hover:bg-gray-600 transition">重置选择</button>
                </div>
                <div id="tradeResult" class="mt-4 text-center hidden">
                    <div class="inline-block bg-green-50 border border-green-200 rounded-lg p-4">
                        <p class="font-bold text-green-700" id="tradeRating"></p>
                        <p class="text-sm text-gray-600 mt-1" id="tradeComment"></p>
                    </div>
                </div>
            </div>
        </div>

        <!-- 标签页6：赛季模拟 -->
        <div class="tab-content" id="tab-5">
            <div class="card">
                <h3 class="text-lg font-bold text-dark mb-4">🏆 赛季全程模拟</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                    <div>
                        <label class="block text-sm font-medium mb-1">模拟赛季次数</label>
                        <select id="seasonSimTimes" class="border rounded-lg p-2 w-full">
                            <option value="1">单赛季精确模拟</option>
                            <option value="10" selected>10次蒙特卡洛</option>
                            <option value="100">100次概率模拟</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">伤病概率</label>
                        <select id="injuryRate" class="border rounded-lg p-2 w-full">
                            <option value="low">低（真实NBA水平）</option>
                            <option value="normal" selected>正常</option>
                            <option value="high">高</option>
                        </select>
                    </div>
                    <div class="flex items-end">
                        <button onclick="runSeasonSim()" class="bg-primary text-white px-6 py-2 rounded-lg hover:bg-secondary transition w-full">开始赛季模拟</button>
                    </div>
                </div>
            </div>

            <div class="card" id="seasonResultCard" style="display:none;">
                <h3 class="text-lg font-bold text-dark mb-4">📊 常规赛最终排名</h3>
                <div class="flex justify-between flex-wrap gap-4">
                    <div class="standings-east">
                        <h4 class="font-bold text-primary mb-2 text-center">东部联盟</h4>
                        <table id="eastStandings"></table>
                    </div>
                    <div class="standings-west">
                        <h4 class="font-bold text-primary mb-2 text-center">西部联盟</h4>
                        <table id="westStandings"></table>
                    </div>
                </div>
            </div>

            <div class="card" id="playoffCard" style="display:none;">
                <h3 class="text-lg font-bold text-dark mb-4">🏀 季后赛对阵图</h3>
                <div class="playoff-bracket" id="playoffBracket"></div>
                <div class="text-center mt-6">
                    <div class="inline-block bg-yellow-50 border-2 border-yellow-400 rounded-lg p-4">
                        <p class="text-sm text-yellow-700">🏆 总冠军</p>
                        <p class="text-2xl font-bold text-yellow-800" id="championTeam">-</p>
                        <p class="text-sm text-gray-600 mt-1" id="championProb"></p>
                    </div>
                </div>
            </div>

            <div class="card" id="champProbCard" style="display:none;">
                <h3 class="text-lg font-bold text-dark mb-4">📈 各队夺冠概率（蒙特卡洛）</h3>
                <div style="max-width: 700px; margin: 0 auto;">
                    <canvas id="champProbChart"></canvas>
                </div>
            </div>
        </div>

