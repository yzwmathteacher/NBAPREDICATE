            renderPlayoffBracket(playoffResult);
            document.getElementById('championTeam').textContent = playoffResult.champion;
            document.getElementById('championProb').textContent = `夺冠概率: ${(champCounts[playoffResult.champion]/simTimes*100).toFixed(1)}%`;

            // 夺冠概率图表
            if (simTimes > 1) {
                const sortedTeams = Object.keys(champCounts).sort((a,b) => champCounts[b] - champCounts[a]).slice(0, 15);
                renderChampProbChart(sortedTeams, sortedTeams.map(t => champCounts[t]/simTimes*100));
