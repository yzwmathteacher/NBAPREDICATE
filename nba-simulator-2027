        // ==================== 批量蒙特卡洛模拟 ====================
        function runBatchSim() {
            const home = document.getElementById('homeTeam').value;
            const away = document.getElementById('awayTeam').value;
            const times = parseInt(document.getElementById('simTimes').value);
            if (!home || !away || home === away) { alert('请选择两支不同的球队'); return; }

            const homeTactic = document.getElementById('homeTactic').value === 'auto' ? 'pickAndRoll' : document.getElementById('homeTactic').value;
            const awayTactic = document.getElementById('awayTactic').value === 'auto' ? 'pickAndRoll' : document.getElementById('awayTactic').value;

            let homeWins = 0;
            let totalHomeScore = 0;
            let totalAwayScore = 0;
            const totalScores = [];

            for (let i = 0; i < times; i++) {
                const res = simulateGame(home, away, homeTactic, awayTactic, 'perimeterMark', 'perimeterMark');
                if (res.winner === 'home') homeWins++;
                totalHomeScore += res.homeScore;
                totalAwayScore += res.awayScore;
                totalScores.push(res.homeScore + res.awayScore);
            }

            const homeWinRate = (homeWins / times * 100).toFixed(1);
            const avgHome = Math.round(totalHomeScore / times);
            const avgAway = Math.round(totalAwayScore / times);
            const avgTotal = Math.round((totalHomeScore + totalAwayScore) / times);
            const avgDiff = Math.abs(avgHome - avgAway);

            currentBatchResult = {
                time: new Date().toLocaleString(),
                home,
                away,
                times,
                homeWinRate,
                avgHome,
                avgAway
            };
            saveHistory({
                time: new Date().toLocaleString(),
                type: '批量模拟',
