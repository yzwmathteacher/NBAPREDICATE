        // ==================== Excel导入与数据解析 ====================
        function importExcel() {
            const file = document.getElementById('excelFile').files[0];
            if (!file) { alert('请先选择Excel文件'); return; }
            
            const reader = new FileReader();
            reader.onload = function(e) {
                const data = new Uint8Array(e.target.result);
                const workbook = XLSX.read(data, { type: 'array' });
                const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
                const jsonData = XLSX.utils.sheet_to_json(firstSheet);
                
                teams = {};
                jsonData.forEach(row => {
                    const teamName = row['球队'] || '未知球队';
                    if (!teams[teamName]) teams[teamName] = { abbr: row['球队缩写'] || '', players: [], stats: null };
                    
                    // 解析球员数据，计算标准化能力值
                    const player = parsePlayerFromRow(row);
                    teams[teamName].players.push(player);
                });

                // 计算每支球队的综合数据
                Object.keys(teams).forEach(teamName => {
                    teams[teamName].stats = calculateTeamStats(teams[teamName].players);
                });

                saveData();
                updateAllTeamSelects();
                renderTeamList();
                document.getElementById('playerDetailCard').style.display = 'block';
                document.getElementById('importTip').classList.remove('hidden');
                document.getElementById('teamCount').textContent = Object.keys(teams).length;
                document.getElementById('playerCount').textContent = jsonData.length;
            };
            reader.readAsArrayBuffer(file);
        }

        // 从Excel行解析球员并计算能力值
        function parsePlayerFromRow(row) {
            const isRookie = row['备注'] && (row['备注'].includes('新秀') || row['备注'].includes('无'));
            const hasData = row['得分PTS'] !== undefined && row['得分PTS'] !== null && row['得分PTS'] !== '';
            
            let pts = Number(row['得分PTS']) || 0;
            let fgPct = Number(row['投篮命中率FG%']) || 0;
            let threePct = Number(row['三分命中率3P%']) || 0;
            let ftPct = Number(row['罚球命中率FT%']) || 0;
            let reb = Number(row['篮板REB']) || 0;
            let ast = Number(row['助攻AST']) || 0;
            let stl = Number(row['抢断STL']) || 0;
            let blk = Number(row['盖帽BLK']) || 0;
            let tov = Number(row['失误TOV']) || 0;
            let min = Number(row['场均时间MIN']) || 0;
            let gp = Number(row['出场数GP']) || 0;

            // 新秀/无数据球员生成基准值
            if (!hasData || isRookie) {
                const pos = row['位置'] || 'G';
                const base = 55 + Math.random() * 10;
                if (pos === 'C') {
                    pts = 8; reb = 6; blk = 1.2; fgPct = 55; threePct = 20;
                } else if (pos === 'F') {
                    pts = 10; reb = 4; ast = 2; fgPct = 45; threePct = 32;
                } else {
                    pts = 12; ast = 4; reb = 2; fgPct = 42; threePct = 35;
                }
                ftPct = 70; stl = 0.8; min = 20; gp = 60;
            }

            // 标准化能力值计算（0-100分）
            const offense = Math.min(100, Math.max(40, 
                pts * 2.5 + fgPct * 0.4 + threePct * 0.2 + ftPct * 0.1 + ast * 1.5
            ));
            const defense = Math.min(100, Math.max(40,
                stl * 15 + blk * 15 + reb * 2 + (100 - tov * 5) * 0.3
            ));
            const threePoint = Math.min(100, Math.max(30, threePct * 1.5 + (row['三分命中3PM'] || pts*0.3) * 3));
            const inside = Math.min(100, Math.max(30, fgPct * 1.2 + reb * 3 + blk * 5));
            const playmaking = Math.min(100, Math.max(30, ast * 5 - tov * 3 + min * 0.5));
            const rebound = Math.min(100, Math.max(30, reb * 7));
            const stamina = Math.min(100, Math.max(40, min * 2 + gp * 0.3));
            const clutch = Math.min(100, Math.max(40, pts * 3 + ftPct * 0.3));

            return {
                name: row['球员中文名'] || row['球员英文名'] || '未知球员',
                nameEn: row['球员英文名'] || '',
                position: row['位置'] || 'G',
                number: row['球衣号'] || '',
                age: Number(row['年龄']) || 25,
                height: Number(row['身高_cm']) || 200,
                weight: Number(row['体重_kg']) || 95,
                experience: Number(row['经验_年']) || 0,
                minutes: min,
                games: gp,
                points: pts,
                offense,
                defense,
                threePoint,
                inside,
                playmaking,
                rebound,
                stamina,
                clutch,
                injured: false,
                injuryType: '健康',
                isRookie
            };
        }

        // ==================== 球队能力计算 ====================
        function calculateTeamStats(players) {
            const availablePlayers = players.filter(p => !p.injured);
            const sorted = [...availablePlayers].sort((a,b) => b.minutes - a.minutes);
            const starters = sorted.slice(0,5);
            const reserves = sorted.slice(5,10);

            const weightedAvg = (playerList, key) => {
                let total = 0, weight = 0;
                playerList.forEach(p => {
                    const w = p.minutes || 20;
                    total += p[key] * w;
                    weight += w;
                });
                return weight > 0 ? total / weight : 60;
            };

            const starterOffense = weightedAvg(starters, 'offense');
            const starterDefense = weightedAvg(starters, 'defense');
            const reserveOffense = weightedAvg(reserves, 'offense');
            const reserveDefense = weightedAvg(reserves, 'defense');

            const overallOffense = starterOffense * 0.7 + reserveOffense * 0.3;
            const overallDefense = starterDefense * 0.7 + reserveDefense * 0.3;
            const overall = overallOffense * 0.55 + overallDefense * 0.45;

            const depth = 100 - Math.abs(starterOffense - reserveOffense) * 2;
            const clutch = weightedAvg(starters.slice(0,2), 'clutch');
            const threeLevel = weightedAvg(starters, 'threePoint');
            const insideLevel = weightedAvg(starters, 'inside');

            return {
                overall: Math.round(overall),
                offense: Math.round(overallOffense),
                defense: Math.round(overallDefense),
                depth: Math.round(Math.max(0, Math.min(100, depth))),
                clutch: Math.round(clutch),
                threeLevel: Math.round(threeLevel),
                insideLevel: Math.round(insideLevel),
                starters,
                reserves,
                totalPlayers: players.length
            };
        }

        // ==================== 比赛模拟核心 ====================
        function simulateGame(homeTeam, awayTeam, homeOffTactic = 'pickAndRoll', awayOffTactic = 'pickAndRoll', homeDefTactic = 'perimeterMark', awayDefTactic = 'perimeterMark') {
            const home = teams[homeTeam].stats;
            const away = teams[awayTeam].stats;

            const homeOffEff = tacticMatrix[homeOffTactic][awayDefTactic];
            const awayOffEff = tacticMatrix[awayOffTactic][homeDefTactic];

            const homeBaseScore = (home.offense * 0.6 + 70) * homeOffEff * gameRules.homeAdvantage;
            const awayBaseScore = (away.offense * 0.6 + 70) * awayOffEff;

            const homeDefFactor = 1 - (home.defense - 60) / 200;
            const awayDefFactor = 1 - (away.defense - 60) / 200;

            const paceMod = (offensiveTactics[homeOffTactic].paceBonus || 1) * 0.5 + (offensiveTactics[awayOffTactic].paceBonus || 1) * 0.5;
            const quarterPace = Math.round(gameRules.pace * paceMod);

            const quarters = [[], []];
            let homeTotal = 0, awayTotal = 0;

            for (let q = 0; q < gameRules.quarters; q++) {
                const rotationMod = (q === 1 || q === 3) ? 0.95 : 1;
                const homeRandom = 0.85 + Math.random() * 0.3;
                const awayRandom = 0.85 + Math.random() * 0.3;

                const homeQuarterScore = Math.round((homeBaseScore * awayDefFactor * rotationMod * homeRandom / gameRules.quarters) * (quarterPace / gameRules.pace) * gameRules.threeFactor);
                const awayQuarterScore = Math.round((awayBaseScore * homeDefFactor * rotationMod * awayRandom / gameRules.quarters) * (quarterPace / gameRules.pace) * gameRules.threeFactor);

                quarters[0][q] = homeQuarterScore;
                quarters[1][q] = awayQuarterScore;
                homeTotal += homeQuarterScore;
                awayTotal += awayQuarterScore;
            }

            // 关键时刻修正
            if (Math.abs(homeTotal - awayTotal) <= 5) {
                const clutchMod = (home.clutch - away.clutch) / 100;
                homeTotal += Math.round(clutchMod * 5);
                awayTotal -= Math.round(clutchMod * 3);
            }

            return {
                homeTeam,
                awayTeam,
                homeScore: Math.max(0, homeTotal),
                awayScore: Math.max(0, awayTotal),
                quarters,
                winner: homeTotal > awayTotal ? 'home' : 'away'
            };
        }

        // ==================== 单场模拟 ====================
        function runSingleSim() {
            const home = document.getElementById('homeTeam').value;
            const away = document.getElementById('awayTeam').value;
            if (!home || !away || home === away) { alert('请选择两支不同的球队'); return; }

            const homeTactic = document.getElementById('homeTactic').value === 'auto' ? 'pickAndRoll' : document.getElementById('homeTactic').value;
            const awayTactic = document.getElementById('awayTactic').value === 'auto' ? 'pickAndRoll' : document.getElementById('awayTactic').value;

            const result = simulateGame(home, away, homeTactic, awayTactic, 'perimeterMark', 'perimeterMark');
            
            document.getElementById('singleResultCard').style.display = 'block';
            document.getElementById('singleHomeName').textContent = home;
            document.getElementById('singleAwayName').textContent = away;
            document.getElementById('singleHomeScore').textContent = result.homeScore;
            document.getElementById('singleAwayScore').textContent = result.awayScore;
            document.getElementById('singleResultText').textContent = result.winner === 'home' ? `${home} 获胜` : `${away} 获胜`;

            const quarterBody = document.getElementById('quarterBody');
            let quarterRows = '';
            const qLabels = ['第一节','第二节','第三节','第四节','第五节','第六节','第七节','第八节'];
            quarterRows += `<tr><td class="font-medium">${home}</td>`;
            for (let i=0; i<gameRules.quarters; i++) quarterRows += `<td>${result.quarters[0][i]}</td>`;
            quarterRows += `<td class="font-bold text-primary">${result.homeScore}</td></tr>`;
            quarterRows += `<tr><td class="font-medium">${away}</td>`;
            for (let i=0; i<gameRules.quarters; i++) quarterRows += `<td>${result.quarters[1][i]}</td>`;
            quarterRows += `<td class="font-bold text-secondary">${result.awayScore}</td></tr>`;
            quarterBody.innerHTML = quarterRows;

            saveHistory({
                time: new Date().toLocaleString(),
                type: '单场模拟',
                match: `${home} vs ${away}`,
                result: `${result.homeScore} : ${result.awayScore}`
            });
        }

        // ==================== 比赛动画 ====================
        function startGameAnimation() {
            const home = document.getElementById('homeTeam').value;
            const away = document.getElementById('awayTeam').value;
            if (!home || !away || home === away) { alert('请选择两支不同的球队'); return; }

            document.getElementById('animationCard').style.display = 'block';
            document.getElementById('animHomeName').textContent = home;
            document.getElementById('animAwayName').textContent = away;
            document.getElementById('animHomeScore').textContent = 0;
            document.getElementById('animAwayScore').textContent = 0;
            document.getElementById('animQuarter').textContent = '第一节 12:00';
            document.getElementById('animEvent').textContent = '比赛开始！中圈跳球...';

            if (gameAnimInterval) clearInterval(gameAnimInterval);
            animPaused = false;
            document.getElementById('animPauseBtn').textContent = '暂停';

            let currentQuarter = 0;
            let timeLeft = 720; // 12分钟=720秒
            let homeScore = 0;
            let awayScore = 0;
            let possession = 'home';
            const qLabels = ['第一节','第二节','第三节','第四节'];

            const canvas = document.getElementById('gameCanvas');
            const ctx = canvas.getContext('2d');
            let ballX = 400, ballY = 225;

            gameAnimInterval = setInterval(() => {
                if (animPaused) return;

                // 绘制球场
                ctx.clearRect(0, 0, 800, 450);
                ctx.fillStyle = '#d4edda';
                ctx.fillRect(0, 0, 800, 450);
                
                // 中线
                ctx.strokeStyle = '#ffffff';
                ctx.lineWidth = 3;
                ctx.beginPath();
                ctx.moveTo(400, 0);
                ctx.lineTo(400, 450);
                ctx.stroke();
                
                // 中圈
                ctx.beginPath();
                ctx.arc(400, 225, 60, 0, Math.PI * 2);
                ctx.stroke();

                // 三分线
                ctx.beginPath();
                ctx.arc(80, 225, 150, -Math.PI/2, Math.PI/2);
                ctx.stroke();
                ctx.beginPath();
                ctx.arc(720, 225, 150, Math.PI/2, -Math.PI/2);
                ctx.stroke();

                // 篮筐
                ctx.fillStyle = '#ff6b6b';
                ctx.beginPath();
                ctx.arc(60, 225, 15, 0, Math.PI * 2);
                ctx.fill();
                ctx.beginPath();
                ctx.arc(740, 225, 15, 0, Math.PI * 2);
                ctx.fill();

                // 球移动动画
                const targetX = possession === 'home' ? 740 : 60;
                const targetY = 200 + Math.random() * 50;
                ballX += (targetX - ballX) * 0.05;
                ballY += (targetY - ballY) * 0.05;

                ctx.fillStyle = '#ff9500';
                ctx.beginPath();
                ctx.arc(ballX, ballY, 8, 0, Math.PI * 2);
                ctx.fill();

                // 时间推进
                timeLeft -= 3;
                const min = Math.floor(timeLeft / 60);
                const sec = timeLeft % 60;
                document.getElementById('animQuarter').textContent = `${qLabels[currentQuarter]} ${min}:${sec.toString().padStart(2,'0')}`;

                // 每24秒一个进攻回合
                if (timeLeft % 24 === 0 && timeLeft > 0) {
                    const isThree = Math.random() < 0.35;
                    const made = Math.random() < 0.45;
                    
                    if (made) {
                        const points = isThree ? 3 : 2;
                        if (possession === 'home') {
                            homeScore += points;
                            document.getElementById('animEvent').textContent = `主队${isThree?'三分':'两分'}命中！+${points}分`;
                        } else {
                            awayScore += points;
                            document.getElementById('animEvent').textContent = `客队${isThree?'三分':'两分'}命中！+${points}分`;
                        }
                        document.getElementById('animHomeScore').textContent = homeScore;
                        document.getElementById('animAwayScore').textContent = awayScore;
                    } else {
                        document.getElementById('animEvent').textContent = `${possession==='home'?'主队':'客队'}投篮不中，篮板球`;
                    }
                    possession = possession === 'home' ? 'away' : 'home';
                }

                // 节间休息
                if (timeLeft <= 0) {
                    currentQuarter++;
                    if (currentQuarter >= gameRules.quarters) {
                        clearInterval(gameAnimInterval);
                        document.getElementById('animEvent').textContent = `比赛结束！最终比分 ${homeScore} : ${awayScore}`;
                        return;
                    }
                    timeLeft = 720;
                    document.getElementById('animEvent').textContent = `第${currentQuarter+1}节开始`;
                }
            }, 50);
        }

        function pauseAnimation() {
            animPaused = !animPaused;
            document.getElementById('animPauseBtn').textContent = animPaused ? '继续' : '暂停';
        }

        function resetAnimation() {
