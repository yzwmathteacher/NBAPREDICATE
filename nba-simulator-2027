                result: `冠军: ${playoffResult.champion}`
            });
        }

        function simulateSingleSeason() {
            const standings = simulateRegularSeason();
            const playoffResult = simulatePlayoffs(standings.east, standings.west);
            return playoffResult.champion;
        }

        function simulateRegularSeason() {
            const eastStandings = {};
            const westStandings = {};
            
            eastTeams.forEach(t => eastStandings[t] = { wins: 0, losses: 0 });
            westTeams.forEach(t => westStandings[t] = { wins: 0, losses: 0 });

            // 简化赛程：同区4场，跨区2场，每队82场
            eastTeams.forEach((t1, i) => {
                eastTeams.forEach((t2, j) => {
                    if (i >= j) return;
                    for (let g = 0; g < 4; g++) {
                        const res = simulateGame(t1, t2);
                        if (res.winner === 'home') { eastStandings[t1].wins++; eastStandings[t2].losses++; }
                        else { eastStandings[t2].wins++; eastStandings[t1].losses++; }
                    }
                });
                westTeams.forEach(t2 => {
                    for (let g = 0; g < 2; g++) {
                        const res = simulateGame(t1, t2);
                        if (res.winner === 'home') { eastStandings[t1].wins++; westStandings[t2].losses++; }
                        else { westStandings[t2].wins++; eastStandings[t1].losses++; }
                    }
                });
            });

            westTeams.forEach((t1, i) => {
                westTeams.forEach((t2, j) => {
                    if (i >= j) return;
                    for (let g = 0; g < 4; g++) {
                        const res = simulateGame(t1, t2);
                        if (res.winner === 'home') { westStandings[t1].wins++; westStandings[t2].losses++; }
                        else { westStandings[t2].wins++; westStandings[t1].losses++; }
                    }
                });
            });

            const eastSorted = Object.entries(eastStandings).sort((a,b) => b[1].wins - a[1].wins);
            const westSorted = Object.entries(westStandings).sort((a,b) => b[1].wins - a[1].wins);
            
            return { east: eastSorted, west: westSorted };
        }

        function simulatePlayoffs(eastStandings, westStandings) {
            const eastTop8 = eastStandings.slice(0,8).map(x => x[0]);
            const westTop8 = westStandings.slice(0,8).map(x => x[0]);

            // 首轮
            const eastQF = [
                playSeries(eastTop8[0], eastTop8[7]),
                playSeries(eastTop8[1], eastTop8[6]),
                playSeries(eastTop8[2], eastTop8[5]),
                playSeries(eastTop8[3], eastTop8[4])
            ];
            const westQF = [
                playSeries(westTop8[0], westTop8[7]),
                playSeries(westTop8[1], westTop8[6]),
                playSeries(westTop8[2], westTop8[5]),
                playSeries(westTop8[3], westTop8[4])
            ];

            // 半决赛
            const eastSF = [playSeries(eastQF[0], eastQF[3]), playSeries(eastQF[1], eastQF[2])];
            const westSF = [playSeries(westQF[0], westQF[3]), playSeries(westQF[1], westQF[2])];

            // 分区决赛
            const eastChamp = playSeries(eastSF[0], eastSF[1]);
            const westChamp = playSeries(westSF[0], westSF[1]);

            // 总决赛
            const champion = playSeries(eastChamp, westChamp);

            return {
                eastQF, eastSF, eastChamp,
                westQF, westSF, westChamp,
                champion
            };
        }

        function playSeries(team1, team2) {
            let t1Wins = 0, t2Wins = 0;
            while (t1Wins < 4 && t2Wins < 4) {
                const home = t1Wins + t2Wins < 2 || t1Wins + t2Wins >= 5 ? team1 : team2;
                const away = home === team1 ? team2 : team1;
                const res = simulateGame(home, away);
                if (res.winner === 'home') {
                    if (home === team1) t1Wins++; else t2Wins++;
                } else {
                    if (away === team1) t1Wins++; else t2Wins++;
                }
            }
            return t1Wins >= 4 ? team1 : team2;
        }

