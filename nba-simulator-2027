        function getTacticAdvice() {
            const myTeam = document.getElementById('myTeam').value;
            const opponent = document.getElementById('opponentTeam').value;
            if (!myTeam || !opponent || myTeam === opponent) { alert('请选择两支不同的球队'); return; }

            const offTacticKeys = Object.keys(offensiveTactics);
            const defTacticKeys = Object.keys(defensiveTactics);
            const results = [];

            offTacticKeys.forEach(offKey => {
                defTacticKeys.forEach(defKey => {
                    let wins = 0;
                    for (let i = 0; i < 200; i++) {
                        const res = simulateGame(myTeam, opponent, offKey, 'pickAndRoll', defKey, 'perimeterMark');
                        if (res.winner === 'home') wins++;
                    }
                    results.push({ off: offKey, def: defKey, winRate: wins / 200 });
                });
            });

            results.sort((a,b) => b.winRate - a.winRate);
            const best = results[0];
            const myStats = teams[myTeam].stats;
            const oppStats = teams[opponent].stats;

            document.getElementById('tacticResultCard').style.display = 'block';
            document.getElementById('bestOffTactic').textContent = offensiveTactics[best.off].name;
            document.getElementById('bestDefTactic').textContent = defensiveTactics[best.def].name;

            let offReason = '';
            if (best.off === 'insideAttack') offReason = `对手内线防守薄弱，我方内线能力(${myStats.insideLevel})占优，强攻篮下效率最高`;
            else if (best.off === 'threePointShoot') offReason = `对手外线防守一般，我方三分能力(${myStats.threeLevel})出色，外线投射可拉开空间`;
            else if (best.off === 'pickAndRoll') offReason = '双方实力均衡，挡拆战术稳定性最高，失误风险低';
            else offReason = '对手节奏慢，我方推快攻可打乱对手防守部署';

            let defReason = '';
            if (best.def === 'paintProtect') defReason = `对手内线能力(${oppStats.insideLevel})强劲，收缩篮下可限制对手禁区得分`;
            else if (best.def === 'perimeterMark') defReason = `对手三分能力(${oppStats.threeLevel})突出，紧逼外线可降低对手投射效率`;
            else if (best.def === 'zoneDefense') defReason = '对手单打能力强，联防可减少防守漏洞，保护内线';
            else defReason = '对手组织能力一般，全场紧逼可增加对手失误，创造反击机会';

            document.getElementById('offTacticReason').textContent = offReason;
            document.getElementById('defTacticReason').textContent = defReason;

            const tips = [];
            if (myStats.insideLevel > oppStats.insideLevel + 5) tips.push('• 优先打内线低位，利用身高优势创造篮下得分机会');
            if (myStats.threeLevel > oppStats.threeLevel + 5) tips.push('• 增加外线出手次数，通过三分球拉开分差');
            if (myStats.depth > oppStats.depth + 5) tips.push('• 增加轮换深度，利用体能优势在第2、4节拉开差距');
            if (myStats.clutch > oppStats.clutch + 5) tips.push('• 关键时刻把球交给核心球员，利用关键球能力终结比赛');
            if (oppStats.offense > myStats.offense + 5) tips.push('• 放慢比赛节奏，减少回合数，降低对手得分机会');
            if (oppStats.defense < myStats.defense - 5) tips.push('• 加快进攻节奏，打对手立足未稳，增加快攻得分');
            tips.push(`• 采用「${offensiveTactics[best.off].name}」+「${defensiveTactics[best.def].name}」组合，预计胜率 ${(best.winRate*100).toFixed(1)}%`);

            document.getElementById('tacticTips').innerHTML = tips.map(t => `<li>${t}</li>`).join('');

            const tableBody = document.getElementById('tacticTableBody');
            tableBody.innerHTML = '';
            offTacticKeys.forEach(offKey => {
                const row = document.createElement('tr');
                row.innerHTML = `<td class="font-medium">${offensiveTactics[offKey].name}</td>`;
                defTacticKeys.forEach(defKey => {
                    const r = results.find(x => x.off === offKey && x.def === defKey);
                    const rate = (r.winRate * 100).toFixed(1);
                    const color = r.winRate > 0.55 ? 'text-green-600 font-bold' : r.winRate < 0.45 ? 'text-red-500' : '';
                    row.innerHTML += `<td class="${color}">${rate}%</td>`;
                });
                tableBody.appendChild(row);
            });
        }

