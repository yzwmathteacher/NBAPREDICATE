                    <div class="font-medium text-dark text-sm">${name}</div>
                    <div class="text-xs text-gray-600">综合：${teams[name].stats.overall} | ${teams[name].players.length}人</div>
                </div>
            `).join('');
        }

        function selectTeamForDetail(name) {
            document.getElementById('detailTeamSelect').value = name;
            renderPlayerDetail();
        }

        function renderPlayerDetail() {
            const teamName = document.getElementById('detailTeamSelect').value;
            if (!teamName) return;
            const players = teams[teamName].players.sort((a,b) => b.minutes - a.minutes);
            
            const container = document.getElementById('playerDetailTable');
            container.innerHTML = `
                <table>
                    <thead>
                        <tr>
                            <th>球员</th>
                            <th>位置</th>
                            <th>年龄</th>
                            <th>场均得分</th>
                            <th>进攻</th>
                            <th>防守</th>
                            <th>三分</th>
                            <th>内线</th>
                            <th>上场时间</th>
                            <th>状态</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${players.map((p, i) => `
                            <tr class="${p.injured ? 'injured' : ''}" onclick="togglePlayerInjury('${teamName}', ${i})" style="cursor:pointer;">
                                <td class="text-left">${p.name}</td>
                                <td>${p.position}</td>
                                <td>${p.age}</td>
                                <td>${p.points.toFixed(1)}</td>
                                <td>${Math.round(p.offense)}</td>
                                <td>${Math.round(p.defense)}</td>
                                <td>${Math.round(p.threePoint)}</td>
                                <td>${Math.round(p.inside)}</td>
                                <td>${p.minutes.toFixed(1)}</td>
                                <td class="${p.injured?'text-red-500':'text-green-600'}">${p.injuryType}</td>
                            </tr>
                        `).join('')}
                    </tbody>
                </table>
            `;
        }

        function toggleInjuryMode() {
            injuryMode = !injuryMode;
            const btn = document.getElementById('injuryModeBtn');
            btn.textContent = injuryMode ? '退出伤病模式' : '设置伤病模式';
            btn.classList.toggle('bg-red-500', injuryMode);
            btn.classList.toggle('bg-orange-500', !injuryMode);
        }

        function togglePlayerInjury(teamName, index) {
            if (!injuryMode) return;
            const p = teams[teamName].players[index];
            p.injured = !p.injured;
            p.injuryType = p.injured ? '受伤缺阵' : '健康';
            teams[teamName].stats = calculateTeamStats(teams[teamName].players);
            saveData();
            renderPlayerDetail();
            renderRank();
        }

        function updateAllTeamSelects() {
            const names = Object.keys(teams).sort();
            const selects = [
                'homeTeam','awayTeam','radarTeam1','radarTeam2','myTeam','opponentTeam',
                'detailTeamSelect','tradeTeamA','tradeTeamB'
            ];
            selects.forEach(id => {
                const el = document.getElementById(id);
                if (el) el.innerHTML = names.map(n => `<option value="${n}">${n}</option>`).join('');
            });
        }

        // ==================== 数据持久化 ====================
        function saveData() {
            localStorage.setItem('nba_teams_2027', JSON.stringify(teams));
        }

        function loadData() {
            const saved = localStorage.getItem('nba_teams_2027');
            if (saved) {
                teams = JSON.parse(saved);
                updateAllTeamSelects();
                renderTeamList();
                renderRank();
                document.getElementById('playerDetailCard').style.display = 'block';
            }
            const savedRules = localStorage.getItem('nba_rules');
            if (savedRules) {
                gameRules = JSON.parse(savedRules);
                updateRuleInputs();
            }
        }

        function clearAllData() {
            if (confirm('确定清空所有球队数据吗？')) {
                teams = {};
                localStorage.removeItem('nba_teams_2027');
                renderTeamList();
                updateAllTeamSelects();
                document.getElementById('importTip').classList.add('hidden');
                document.getElementById('playerDetailCard').style.display = 'none';
            }
        }

        function saveHistory(record) {
            simHistory.unshift(record);
            if (simHistory.length > 100) simHistory = simHistory.slice(0, 100);
            localStorage.setItem('nba_sim_history', JSON.stringify(simHistory));
            renderHistory();
        }

        function renderHistory() {
            const saved = localStorage.getItem('nba_sim_history');
            if (saved) simHistory = JSON.parse(saved);
            const tbody = document.getElementById('historyBody');
            if (simHistory.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-gray-400 py-8">暂无模拟记录</td></tr>';
                return;
            }
            tbody.innerHTML = simHistory.map((h, i) => `
                <tr>
                    <td class="text-sm">${h.time}</td>
                    <td>${h.type}</td>
                    <td>${h.match}</td>
                    <td class="text-primary font-medium">${h.result}</td>
                    <td><button onclick="deleteHistory(${i})" class="text-red-500 text-sm">删除</button></td>
                </tr>
            `).join('');
        }

        function deleteHistory(index) {
            simHistory.splice(index, 1);
            localStorage.setItem('nba_sim_history', JSON.stringify(simHistory));
            renderHistory();
        }

        function clearHistory() {
            if (confirm('确定清空所有模拟记录吗？')) {
                simHistory = [];
                localStorage.removeItem('nba_sim_history');
                renderHistory();
            }
        }

        function exportSimResult() {
            if (!currentBatchResult) { alert('请先运行批量模拟'); return; }
            const data = [
                ['对阵', `${currentBatchResult.home} vs ${currentBatchResult.away}`],
                ['模拟次数', currentBatchResult.times],
                ['主队胜率', currentBatchResult.homeWinRate + '%'],
                ['客队胜率', (100 - currentBatchResult.homeWinRate).toFixed(1) + '%'],
                ['主队场均得分', currentBatchResult.avgHome],
                ['客队场均得分', currentBatchResult.avgAway],
                ['模拟时间', currentBatchResult.time]
            ];
            const ws = XLSX.utils.aoa_to_sheet(data);
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, '模拟结果');
            XLSX.writeFile(wb, `比赛模拟结果_${currentBatchResult.home}vs${currentBatchResult.away}.xlsx`);
        }

        // 初始化
        window.onload = function() {
            loadData();
            renderHistory();
        };
    </script>
</body>
</html>
