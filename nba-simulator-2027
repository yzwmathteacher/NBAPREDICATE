        const tacticMatrix = {
            insideAttack: { paintProtect: 0.85, perimeterMark: 1.1, zoneDefense: 1.05, fullCourtPress: 0.92 },
            threePointShoot: { paintProtect: 1.12, perimeterMark: 0.9, zoneDefense: 1.08, fullCourtPress: 0.95 },
